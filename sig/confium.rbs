module Confium
  VERSION: String

  module Native
    def self.version: () -> String
    def self.loaded?: () -> bool
  end

  def self.core_version: () -> String

  # Bridge into the FFI layer used by the Digest/CFM companions.
  def self.call_ffi: (Symbol function, *untyped args) -> untyped

  class Error < StandardError
    attr_reader details: Hash[Symbol, untyped]

    def initialize: (?String? message, ?details: Hash[Symbol, untyped]) -> void
    def to_h: () -> Hash[Symbol, untyped]
  end

  class ParseError < Error
    attr_reader format: String?
    attr_reader offset: Integer?
    def initialize: (?String? message, ?Hash[Symbol, untyped]? details_hash, **untyped kwargs) -> void
  end

  class ValidationError < Error
    attr_reader param: String?
    attr_reader expected: String?
    attr_reader actual: String?
    def initialize: (?String? message, ?Hash[Symbol, untyped]? details_hash, **untyped kwargs) -> void
  end

  class VerificationError < Error
    attr_reader signer_index: Integer?
    attr_reader algorithm: String?
    def initialize: (?String? message, ?Hash[Symbol, untyped]? details_hash, **untyped kwargs) -> void
  end

  class ThresholdError < Error
    attr_reader have_count: Integer?
    attr_reader need_count: Integer?
    def initialize: (?String? message, ?Hash[Symbol, untyped]? details_hash, **untyped kwargs) -> void
  end

  class CryptoError < Error
    attr_reader primitive: String?
    def initialize: (?String? message, ?Hash[Symbol, untyped]? details_hash, **untyped kwargs) -> void
  end

  class NotFoundError < Error
    def initialize: (?String? message, ?Hash[Symbol, untyped]? details_hash, **untyped kwargs) -> void
  end

  class IndexError < Error
    def initialize: (?String? message, ?Hash[Symbol, untyped]? details_hash, **untyped kwargs) -> void
  end

  class UnresolvedSignerError < Error
    def initialize: (?String? message, ?Hash[Symbol, untyped]? details_hash, **untyped kwargs) -> void
  end

  class PolicyViolationError < Error
    attr_reader policy: Symbol?
    attr_reader violation: Symbol?
    def initialize: (?String? message, ?Hash[Symbol, untyped]? details_hash, **untyped kwargs) -> void
  end

  module Errors
    # Normalizes the (message, details_hash, **kwargs) constructor
    # forms used by the typed error subclasses.
    module Coerce
      def self.args: (untyped message, untyped details_hash, Hash[Symbol, untyped] kwargs) -> [ String?, Hash[Symbol, untyped] ]
      def args: (untyped message, untyped details_hash, Hash[Symbol, untyped] kwargs) -> [ String?, Hash[Symbol, untyped] ]
    end
  end

  module Crypto
    def self.register: (Symbol name, untyped klass) -> untyped
    def self.lookup: (Symbol name) -> untyped
    def self.interfaces: () -> Array[Symbol]
  end

  module Policy
    JURISDICTIONS: Hash[Symbol, Hash[Symbol, untyped]]

    def self.jurisdiction: () -> Symbol?
    def self.jurisdiction=: (Symbol? value) -> Symbol?
    def self.fips_mode: () -> bool
    def self.fips_mode=: (bool value) -> bool
    def self.check!: (String | Symbol algorithm, key_bits: Integer) -> bool
    def self.known_jurisdictions: () -> Array[Symbol]
    def self.reset!: () -> void
  end

  class SecureBytes
    class ClearedError < Error
      def initialize: (?String message) -> void
    end

    def self.wrap: (String raw) -> SecureBytes
    def initialize: (String raw) -> void
    def bytes: () -> String
    def bytes!: () -> String
    def clear: () -> void
    def cleared?: () -> bool
    def length: () -> Integer
    def size: () -> Integer

    private

    # Returns the (callable) finalize method; ObjectSpace accepts
    # any callable as a finalizer.
    def finalizer_proc: () -> untyped

    def finalize: (untyped id) -> void
  end

  module Audit
    def self.record: (String operation, String actor_id, String status, String? detail, String? algorithm, String? outcome) -> void
    def self.sink: () -> Sink?
    def self.sink=: (Sink? sink) -> void
    def self.enabled?: () -> bool

    # Base class for audit sinks. The native extension dispatches
    # records by calling `.call(record)`.
    class Sink
      def write: (untyped record) -> void
      def call: (untyped record) -> void
      def close: () -> void
    end

    class MemorySink < Sink
      include Enumerable[untyped]
      def initialize: () -> void
      def records: () -> Array[untyped]
      def clear: () -> void
      def each: () { (untyped record) -> void } -> void
                | () -> Enumerator[untyped, void]
    end

    class StderrSink < Sink
      def initialize: (?io: untyped io) -> void
    end

    class FileSink < Sink
      def initialize: (String path) -> void
    end
  end

  module OpenPGP
    MESSAGE: String
    PUBLIC_KEY: String
    SECRET_KEY: String
    SIGNATURE: String
    CLEARTEXT: String
    LABELS: Hash[String?, String]
    CRC_POLY: Integer
    CRC_INIT: Integer
    B64_CHARS: Array[String]
    CRC_TABLE: Array[Integer]

    def self.armor: (String data, ?String type) -> String
    def self.dearmor: (String data) -> String

    private

    def self.extract_body: (String text) -> [ String, String? ]
    def self.block_lines: (String text) -> Array[String]
    def self.block_slice: (String normalized) -> String
    def self.collect_data: (Array[String] lines) -> [ String, String? ]
    def self.crc24_armor: (String bytes) -> String
  end
end

module Confium::Transparency
  class MerkleTree
    def initialize: () -> void
    def append: (String artifact_hash_bytes) -> Integer
    def length: () -> Integer
    def size: () -> Integer
    def empty?: () -> bool
    def root: () -> String
    def entries: () -> Array[untyped]
    def to_a: () -> Array[untyped]
    def inclusion_proof: (Integer sequence) -> InclusionProof
    def consistency_proof: (Integer sequence) -> Array[untyped]
    def verify_consistency: (String old_root, String new_root, Integer old_size, Integer new_size, Array[untyped] proof) -> bool
  end

  class InclusionProof
    def sequence: () -> Integer
    def steps: () -> Hash[Integer, { sibling: String, side: String }]
    def verify: (String root_bytes) -> bool
    def verify_with_leaf: (String leaf_hash, String root_bytes) -> bool
  end

  module OTS
    DEFAULT_CALENDARS: Array[String]

    class Receipt
      def initialize: (bytes: String, ?block_height: Integer?) -> void
      def to_bytes: () -> String
    end

    # Stub — calendar-server stamping is wired through the Rust
    # extension in a future release.
    def self.stamp: (String hash) -> untyped
    def self.verify: (untyped receipt, String hash) -> untyped
  end

  module ERS
    class EvidenceRecord
      def self.build_initial: (String data_hash, String tsa_label, String token_bytes) -> EvidenceRecord
      def renewal_count: () -> Integer
      def renew: (String data_hash, String tsa_label, String token_bytes) -> EvidenceRecord
    end
  end
end

module Confium::Composite
  def self.generate_ed25519_keypair: () -> Hash[String, String]
  def self.sign_ed25519: (String private_key_bytes, String message_bytes) -> Hash[String, String]
  def self.sign_p256: (String private_key_bytes, String message_bytes) -> Hash[String, String]

  class Signature
    BINARY_FIELDS: Array[String]

    def self.new: (Array[Hash[String, String]] components) -> untyped
    def self.components_to_json: (Array[Hash[String, String]] components) -> String
    def self.from_json: (String | Array[untyped] | Hash[String, untyped] json) -> Signature

    private

    def self.decode_binary_fields: (Hash[String, untyped] component) -> Hash[String, untyped]

    public

    def component_count: () -> Integer
    def algorithms: () -> Array[String]
    def verify: (String message_bytes, ?Hash[String, untyped] verifiers) -> VerificationResult
  end

  class VerificationResult
    def all_verified?: () -> bool
    def per_component: () -> Hash[Integer, untyped]
  end
end

module Confium::Attributes
  def self.parse: (String dsl_expression) -> Predicate

  class Predicate
    def satisfied_by?: (Array[Signer] signers) -> bool
  end

  class Signer
    def initialize: () -> void
    def add: (String key, String value) -> void
    def has?: (String key) -> bool
    def values: (String key) -> Array[String]
  end
end

module Confium::PKI
  class Certificate
    def self.from_der: (String der_bytes) -> Certificate
    def self.from_pem: (String pem_text) -> Certificate
    def to_der: () -> String
    def to_pem: () -> String
    def fingerprint_sha256: () -> String
    def serial_hex: () -> String
    def not_before: () -> String
    def not_after: () -> String
    def valid_at?: (String iso8601_time) -> bool
    def public_key_bytes: () -> String
  end

  class CSR
    def self.from_der: (String der_bytes) -> CSR
    def self.from_pem: (String pem_text) -> CSR
    def to_der: () -> String
    def to_pem: () -> String
  end

  class CertificateBuilder
    def subject: () -> String?
    def subject=: (String value) -> String
    def issuer: () -> String?
    def issuer=: (String value) -> String
    def serial: () -> Integer?
    def serial=: (Integer value) -> Integer
    def not_before: () -> untyped
    def not_before=: (untyped value) -> untyped
    def not_after: () -> untyped
    def not_after=: (untyped value) -> untyped
    # Returns cert metadata; full DER construction needs x509 builder
    # support in the Rust extension.
    def build_self_signed: (algorithm: Symbol, private_key: String) -> Hash[Symbol, untyped]
  end

  class PathValidator
    def self.validate: (Certificate leaf, Array[Certificate]? intermediates, Certificate root, ?String time_iso8601) -> PathValidationResult
  end

  class PathValidationResult
    def valid?: () -> bool
    def check_count: () -> Integer
    def checks_json: () -> String
  end

  module CMS
    class SignedData
      def self.from_json: (String json) -> SignedData
      def self.build_detached: (String signature, String algorithm_oid, Array[String] cert_ders) -> SignedData
      def to_json: () -> String
      def signer_count: () -> Integer
      def signing_time: () -> String?
      def content_type: () -> String
      def content: () -> Content?
      def certificate_count: () -> Integer
      def certificate_at: (Integer index) -> String
    end

    class Content
      def bytes: () -> String
      def length: () -> Integer
      def size: () -> Integer
    end

    class SignedDataBuilder
      SIGNATURE_ALGORITHM_OID: Hash[Symbol, String]

      def initialize: () -> void
      def content: () -> String?
      def content=: (String value) -> String
      def add_signer: (cert_der: String, private_key: String, algorithm: Symbol | String) -> void
      def build: () -> SignedData

      private

      def sign_payload: (Symbol algorithm, String private_key, String payload) -> String
    end
  end

  module CNML
    REQUIRED_EXTENSIONS: Hash[String, untyped]
    OPTIONAL_EXTENSIONS: Hash[String, untyped]
    CERT_ROLES: Array[Symbol]

    def self.missing_extensions: (Certificate cert) -> Array[String]
    def self.required_extension_oids: () -> Array[String]
    def self.optional_extension_oids: () -> Array[String]
    def self.cert_roles: () -> Array[Symbol]
  end

  module XMLDSig
    def self.canonicalize: (String xml) -> String
    def self.canonicalize_exclusive: (String xml) -> String
  end
end

module Confium::Identity
  ACTOR_TYPES: Array[String]

  def self.actor_types: () -> Array[String]

  class Actor
    def self.from_json: (String json) -> Actor
    def to_json: () -> String
    def actor_id: () -> String
    def actor_type: () -> String
    def quorum_id: () -> String?
    def registered_at: () -> String
    def expires_at: () -> String?
    def certificate_count: () -> Integer
  end
end

module Confium::Config
  class Manifest
    def self.from_toml: (String toml) -> Manifest
    def deployment_name: () -> String
    def operator: () -> String
    def manifest_version: () -> Integer
    def tier_count: () -> Integer
    def tier_name_at: (Integer index) -> String
    def quorum_count: () -> Integer
    def validate: () -> Array[String]
    def valid?: () -> bool
  end
end

module Confium::TC
  module FrostP256
    def self.generate_keypair: () -> Hash[String, String]
    def self.split_secret: (String secret_bytes, Integer threshold, Integer party_count) -> Array[Share]
    def self.recover_secret: (Array[{ x: Integer, y: String }] shares) -> String
    def self.sign: (String private_key_bytes, String message_bytes) -> Hash[String, String]

    class Share
      def x: () -> Integer
      def y_bytes: () -> String
    end
  end

  module ElGamalP256
    def self.encapsulate: (String public_key_bytes) -> Hash[String, untyped]
    def self.partial_decrypt: (Integer party_index, String share_bytes, Hash[String, String] ciphertext) -> Hash[String, untyped]
    def self.aggregate_partials: (Array[Hash[String, untyped]] partials, Integer threshold, Hash[String, String] ciphertext) -> String
  end

  module Cmp20
    def self.keygen: (Integer threshold, Integer party_count) -> Hash[String, untyped]
    def self.sign: (Array[String] shares, Integer threshold, String message_bytes) -> String
  end

  module Gg18
    def self.keygen: (Integer threshold, Integer party_count) -> Hash[String, untyped]
    def self.sign: (Array[String] shares, Integer threshold, String message_bytes) -> String
  end

  class Session
    attr_reader scheme: String
    attr_reader threshold: Integer
    attr_reader num_parties: Integer
    attr_reader party_index: Integer
    attr_reader state: Symbol

    def initialize: (scheme: String, threshold: Integer, num_parties: Integer, party_index: Integer) -> void
    def set_local_share: (String share_bytes) -> void
    def complete?: () -> bool
    def result: () -> untyped
  end

  # Placeholder for the multi-party TC session interface; the real
  # orchestration is wired through the extension in a future release.
  class SessionStub
    attr_reader scheme: String
    attr_reader threshold: Integer
    attr_reader party_count: Integer
    attr_reader this_party_idx: Integer
    attr_reader round: Integer

    def initialize: (scheme: String, threshold: Integer, party_count: Integer, this_party_idx: Integer) -> void
    def complete?: () -> bool
    def round_step: (Array[untyped] incoming_messages) -> Hash[Symbol, untyped]
    def result: () -> nil
  end

  class Coordinator
    attr_reader quorum_id: String
    attr_reader sessions: Hash[String, Hash[Symbol, untyped]]

    def initialize: (quorum_id: String) -> void
    def create_session: (message: String, threshold: Integer, ?unlock_window: Integer) -> String
    def session_state: (String session_id) -> Symbol?
    def submit_commitment: (String session_id, String signer_id, String commitment_bytes) -> void
    def submit_share: (String session_id, String signer_id, String share_bytes) -> void
    def aggregate: (String session_id) -> String
  end

  class ShareFile
    attr_reader scheme: String
    attr_reader threshold: Integer?
    attr_reader party_count: Integer
    attr_reader public_key: String
    attr_reader shares: Array[String]

    def initialize: (scheme: String, threshold: Integer?, party_count: Integer, public_key: String, shares: Array[String]) -> void
    def self.load: (String path) -> ShareFile
    def self.from_json: (String json) -> ShareFile
    def self.from_keygen: (String scheme_name, Hash[String, untyped] keygen_result) -> ShareFile
    def save: (String path) -> ShareFile
    def to_json: (*untyped args) -> String
  end
end
